<div class="off-canvas position-right" id="cartSidebar" data-off-canvas data-transition="overlap">
  <div class="cart-sidebar-title">
    {{ 'cart.general.title' | t }}

    <button class="close-button" aria-label="Close menu" type="button" data-close>
      <span aria-hidden="true">&times;</span>
    </button>
  </div>

  <div id="wfShippingProgress" class="wf-shipping-progress" style="display:none;">
    <div id="wfShippingMessage" class="wf-shipping-message">
      🚚 Envío $99
    </div>

    <div class="wf-shipping-bar">
      <div id="wfShippingBarFill" class="wf-shipping-bar-fill"></div>
    </div>
  </div>

  <div id="cartSidebarContainer">
    {% if cart.item_count == 0 %}
      <p class="row columns">
        {{ 'cart.general.empty' | t }}
      </p>
    {% endif %}
  </div>

  {%- comment -%} ⬇️ INICIO: SECCIÓN DE FAVORITOS EN EL CARRITO ⬇️ {%- endcomment -%}
  <div class="row columns">
    <div id="wf-cart-favorites" class="wf-cart-favorites" style="display: none;">
      <h3 class="wf-cart-fav-title">Tus Favoritos Guardados</h3>
      <div id="wf-cart-fav-list" class="wf-cart-fav-list">
        </div>
    </div>
  </div>
  {%- comment -%} ⬆️ FIN: SECCIÓN DE FAVORITOS ⬆️ {%- endcomment -%}

</div>

<script>
  /* ========================================================
     SISTEMA DE FAVORITOS (LECTOR DE MEMORIA Y API DE SHOPIFY)
     ======================================================== */
  function renderWFFavorites() {
    var container = document.getElementById('wf-cart-favorites');
    var list = document.getElementById('wf-cart-fav-list');
    if (!container || !list) return;

    var favs = JSON.parse(localStorage.getItem('wf_favorites')) || [];

    // Si no hay favoritos, ocultamos la sección
    if (favs.length === 0) {
      container.style.display = 'none';
      list.innerHTML = '';
      return;
    }

    container.style.display = 'block';
    list.innerHTML = '<div style="font-size: 0.75rem; opacity: 0.5;">Cargando favoritos...</div>';

    // Buscamos los datos de cada producto usando la API de Shopify
    var fetchPromises = favs.map(function(handle) {
      return fetch('/products/' + handle + '.js')
        .then(function(res) { return res.json(); })
        .catch(function() { return null; });
    });

    Promise.all(fetchPromises).then(function(products) {
      list.innerHTML = '';
      
      products.forEach(function(product) {
        if (!product) return;
        
        // Formatear precio (Shopify lo devuelve en centavos)
        var price = (product.price / 100).toLocaleString('en-US', { style: 'currency', currency: 'USD' });
        
        var html = `
          <div class="wf-fav-item">
            <a href="${product.url}" class="wf-fav-img-link">
              <img src="${product.images[0]}" alt="${product.title}">
            </a>
            <div class="wf-fav-info">
              <a href="${product.url}" class="wf-fav-title">${product.title}</a>
              <span class="wf-fav-price">${price}</span>
              <button type="button" class="wf-fav-remove js-remove-fav" data-handle="${product.handle}">Quitar</button>
            </div>
          </div>
        `;
        list.insertAdjacentHTML('beforeend', html);
      });
    });
  }

  // 1. Cargar favoritos cuando se abre la página
  document.addEventListener('DOMContentLoaded', renderWFFavorites);
  
  // 2. Escuchar si el usuario marca un nuevo corazón para actualizar en tiempo real
  window.addEventListener('wf-favorites-updated', renderWFFavorites);

  // 3. Funcionalidad del botón "Quitar" dentro del carrito
  document.addEventListener('click', function(e) {
    if (e.target.classList.contains('js-remove-fav')) {
      e.preventDefault();
      var handle = e.target.getAttribute('data-handle');
      var favs = JSON.parse(localStorage.getItem('wf_favorites')) || [];
      
      // Filtramos y borramos el producto de la memoria
      favs = favs.filter(function(h) { return h !== handle; });
      localStorage.setItem('wf_favorites', JSON.stringify(favs));
      
      // Actualizamos el carrito
      renderWFFavorites();
      
      // Apagamos el corazón en la tienda (si es que está visible en pantalla)
      var hearts = document.querySelectorAll('.js-add-to-favs[data-product-handle="'+handle+'"]');
      hearts.forEach(function(h) { h.classList.remove('is-active'); });
    }
  });
</script>
<script>
(function () {
  const FREE_SHIPPING = 200000; // $2,000 MXN en centavos

  function formatMoney(cents) {
    return new Intl.NumberFormat('es-MX', {
      style: 'currency',
      currency: 'MXN',
      maximumFractionDigits: 0
    }).format(cents / 100);
  }

  async function updateWFShippingProgress() {
    const box = document.getElementById('wfShippingProgress');
    const message = document.getElementById('wfShippingMessage');
    const fill = document.getElementById('wfShippingBarFill');

    if (!box || !message || !fill) return;

    try {
      const response = await fetch('/cart.js', {
        credentials: 'same-origin'
      });

      const cart = await response.json();
      const total = cart.total_price || 0;

      if (cart.item_count === 0) {
        box.style.display = 'none';
        return;
      }

      box.style.display = 'block';

      if (total >= FREE_SHIPPING) {
        message.innerHTML = '🎉 ¡Ya tienes <strong>ENVÍO GRATIS!</strong>';
        fill.style.width = '100%';
      } else {
        const remaining = FREE_SHIPPING - total;
        const progress = Math.min((total / FREE_SHIPPING) * 100, 100);

        message.innerHTML =
          '🚚 Envío <strong>$99</strong> · Te faltan <strong>' +
          formatMoney(remaining) +
          '</strong> para ENVÍO GRATIS';

        fill.style.width = progress + '%';
      }
    } catch (error) {
      console.log('WF Shipping Progress:', error);
    }
  }

  document.addEventListener('DOMContentLoaded', function () {
    updateWFShippingProgress();

    const cartSidebar = document.getElementById('cartSidebar');

    if (cartSidebar) {
      let timer;

      const observer = new MutationObserver(function (mutations) {
        const cartChanged = mutations.some(function (mutation) {
          const target = mutation.target;

          return !(
            target.nodeType === 1 &&
            target.closest &&
            target.closest('#wfShippingProgress')
          );
        });

        if (cartChanged) {
          clearTimeout(timer);
          timer = setTimeout(updateWFShippingProgress, 250);
        }
      });

      observer.observe(cartSidebar, {
        childList: true,
        subtree: true,
        characterData: true
      });
    }
  });
})();
// WF - Aplicar código de descuento desde carrito lateral
document.addEventListener('click', function(e) {
  var btn = e.target.closest('#wfCartDiscountApply');
  if (!btn) return;

  e.preventDefault();

  var box = btn.closest('.wf-cart-discount');
  var input = box.querySelector('.wf-cart-discount-input');
  var code = input.value.trim();

  var status = box.querySelector('.wf-cart-discount-status');

  if (!status) {
    status = document.createElement('div');
    status.className = 'wf-cart-discount-status';
    box.appendChild(status);
  }

  if (!code) {
    status.textContent = 'Escribe un código de descuento.';
    return;
  }

  btn.disabled = true;
  btn.textContent = 'APLICANDO...';
  status.textContent = '';

  var root = (window.Shopify && Shopify.routes)
    ? Shopify.routes.root
    : '/';

  fetch(root + 'cart/update.js', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Accept': 'application/json'
    },
    body: JSON.stringify({
      discount: code
    })
  })
  .then(function(response) {
    if (!response.ok) throw new Error('Error');
    return response.json();
  })
  .then(function(data) {
  var applied = data.discount_codes &&
    data.discount_codes.some(function(d) {
      return d.code &&
        d.code.toLowerCase() === code.toLowerCase() &&
        d.applicable !== false;
    });

  if (applied) {
    status.textContent = '✓ Código aplicado';
    status.classList.add('is-success');
  } else {
    status.textContent = 'Código no válido o no aplica a este carrito.';
    status.classList.remove('is-success');
  }
})
  .catch(function() {
    status.textContent = 'No se pudo aplicar el código.';
    status.classList.remove('is-success');
  })
  .finally(function() {
    btn.disabled = false;
    btn.textContent = 'APLICAR';
  });
});
// WF - Recomendaciones dentro del carrito
function loadWFCartRecommendations() {
  var box = document.getElementById('wfCartRecommendations');
  var list = document.getElementById('wfCartRecommendationsList');

  if (!box || !list) return;

  var root = (window.Shopify && Shopify.routes)
    ? Shopify.routes.root
    : '/';

  fetch(root + 'cart.js')
    .then(function(response) {
      if (!response.ok) throw new Error('No se pudo leer el carrito');
      return response.json();
    })
    .then(function(cart) {
      if (!cart.items || !cart.items.length) {
        box.style.display = 'none';
        return null;
      }

      var currentProductIds = cart.items.map(function(item) {
        return item.product_id;
      });

      var productId = cart.items[0].product_id;

      return fetch(
        root + 'recommendations/products.json?product_id=' +
        productId +
        '&limit=6&intent=related'
      )
      .then(function(response) {
        if (!response.ok) throw new Error('No se pudieron cargar recomendaciones');
        return response.json();
      })
      .then(function(data) {
        var products = (data.products || []).filter(function(product) {
          return currentProductIds.indexOf(product.id) === -1;
        }).slice(0, 6);

        if (!products.length) {
          box.style.display = 'none';
          return;
        }

        list.innerHTML = '';

        products.forEach(function(product) {
          var image = product.featured_image || '';
          var url = product.url || (root + 'products/' + product.handle);

          var price = new Intl.NumberFormat('es-MX', {
            style: 'currency',
            currency: 'MXN',
            minimumFractionDigits: 0
          }).format(product.price / 100);

          var card = document.createElement('div');
          card.className = 'wf-cart-recommendation-card';

          card.innerHTML =
            '<a href="' + url + '" class="wf-cart-recommendation-image">' +
              '<img src="' + image + '" alt="' + product.title + '">' +
            '</a>' +
            '<div class="wf-cart-recommendation-info">' +
              '<a href="' + url + '" class="wf-cart-recommendation-name">' +
                product.title +
              '</a>' +
              '<div class="wf-cart-recommendation-price">' + price + '</div>' +
            '</div>';

          list.appendChild(card);
        });

        box.style.display = 'block';
      });
    })
    .catch(function() {
      if (box) box.style.display = 'none';
    });
}

loadWFCartRecommendations();
// Volver a cargar recomendaciones cuando cambie el carrito
var wfRecTimer;

var wfRecObserver = new MutationObserver(function(mutations) {
  var cartReallyChanged = mutations.some(function(mutation) {
    var el = mutation.target.nodeType === 1
      ? mutation.target
      : mutation.target.parentElement;

    return !(
      el &&
      el.closest &&
      el.closest('#wfCartRecommendations')
    );
  });

  if (!cartReallyChanged) return;

  clearTimeout(wfRecTimer);

  wfRecTimer = setTimeout(function() {
    loadWFCartRecommendations();
  }, 400);
});

var wfCartSidebar = document.getElementById('cartSidebar');

if (wfCartSidebar) {
  wfRecObserver.observe(wfCartSidebar, {
    childList: true,
    subtree: true
  });
}
</script>