{% assign current_variant = product.selected_or_first_available_variant %}
<div data-section-id="{{ section.id }}" data-section-type="product-page"  itemscope itemtype="http://schema.org/Product">
  <meta itemprop="name" content="{{ product.title }}">
  <meta itemprop="url" content="{{ shop.url }}{{ product.url }}">
  <meta itemprop="image" content="{{ product.featured_image.src | img_url: '800x' }}">

  <div class="row product-single js-animate-appear-show">
    {% case section.settings.images_width %}
      {% when '30' %}
        {% assign product_images_grid = 'large-4 columns' %}
        {% assign product_info_grid = 'large-8 columns' %}
      {% when '50' %}
        {% assign product_images_grid = 'large-6 columns' %}
        {% assign product_info_grid = 'large-6 columns' %}
      {% when '60' %}
        {% assign product_images_grid = 'large-7 columns' %}
        {% assign product_info_grid = 'large-5 columns' %}
      {% when '70' %}
        {% assign product_images_grid = 'large-8 columns' %}
        {% assign product_info_grid = 'large-4 columns' %}
    {% endcase %}
    <div class="{{ product_images_grid }} product-images">
      <div class="product-images__container">
        <div class="{% if product.images.size > 1 %}is-carousel{% endif %} {% if section.settings.enable_lightbox %}images-lightbox{% endif %}" id="ProductImages" data-featured-img="{{product.selected_or_first_available_variant.featured_image}}">
          {% for image in product.images %}
            <div class="product-image__slide" data-img-id="{{image.id}}">
              {%- assign img_url = image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' -%}
              {% if section.settings.enable_lightbox %}
              <a class="product__image__item" title="{{ image.alt | escape }}" href="{{ image | img_url: 'master' }}">
              {% else %}
              <div class="product__image__item">
              {% endif %}
                <img class="lazyload {% if forloop.index == 1 %} __first-image {% endif %}"
                src="{{ image | img_url: '300x300' }}"
                data-src="{{ img_url }}"
                data-widths="[180, 360, 540, 720, 900, 1080, 1296, 1512, 1728, 2048]"
                data-aspectratio="{{ image.aspect_ratio }}"
                data-sizes="auto"
                alt="{{ image.alt | escape }}">
              {% if section.settings.enable_lightbox %}
              </a>
              {% else %}
              </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
      {% if product.images.size > 1 %}
        <div class="product__thumbs row medium-up-5 large-up-5" id="ProductThumbs">
          {% for image in product.images %}
            <div class="product__thumb column {% if forloop.index0 == 0 %}active{% endif %}" data-thumb-id="{{image.id}}">
              <img src="{{ image.src | img_url: 'compact' }}" alt="{{ image.alt | escape }}">
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="{{ product_info_grid }} product-card">
      <div class="product-info__container">
        <h1 class="product-title" itemprop="name">{{ product.title }}</h1>
        {% if section.settings.display_product_vendor %}
          <div class="product-vendor">{{ product.vendor | link_to_vendor }}</div>
        {% endif %}

        {% if settings.add_spr_markup %}
          <div class="spr-badge-container">
            <span class="shopify-product-reviews-badge" data-id="{{ product.id }}"></span>
          </div>
        {% endif %}

        <div itemprop="offers" itemscope itemtype="http://schema.org/Offer">
          <meta itemprop="priceCurrency" content="{{ shop.currency }}">
          <link itemprop="availability" href="http://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}">
          {% comment %}
            ID addToCartForm is a selector for the ajax cart plugin
          {% endcomment %}
          <form action="/cart/add" method="post" enctype="multipart/form-data" id="AddToCartForm" class="form-vertical">

            <style>
  #ComparePrice,
  #ComparePrice .money {
    color: #111110 !important;
    -webkit-text-fill-color: #111110 !important;
    text-decoration-color: #ed0808ff !important;
    opacity: 1 !important;
  }
</style>
            <div class="product__price__wrap">
              {% if product.compare_at_price_max > product.price %}
                <span class="visually-hidden">{{ 'products.general.sale_price' | t }}</span>
                <s id="ComparePrice">
                  <span class="money">{{ current_variant.compare_at_price | money }}</span>
                </s>
              {% endif %}

              <span class="visually-hidden">{{ 'products.general.regular_price' | t }}</span>
              <span id="ProductPrice" itemprop="price" content="{{ current_variant.price | divided_by: 100.00 }}">
                <span class="money">{{ current_variant.price | money }}</span>
              </span>
            </div>

            <div class="product__variants__wrap">
              <div class="product__variants_no-js">
                <select name="id" id="productSelect" class="product-single__variants">
                  {% for variant in product.variants %}
                    {% if variant.available %}
                      <option {% if variant == product.selected_or_first_available_variant %} selected="selected" {% endif %} data-sku="{{ variant.sku }}" value="{{ variant.id }}">{{ variant.title }} - {{ variant.price | money_with_currency }}</option>
                    {% else %}
                      <option disabled="disabled">
                        {{ variant.title }} - {{ 'products.product.sold_out' | t }}
                      </option>
                    {% endif %}
                  {% endfor %}
                </select>
              </div>

              {% if product.available and product.variants.size > 0 %}
                {% for option in product.options %}
                  {% include 'swatch' with option %}
                {% endfor %}
              {% endif %}
            </div>

            <div class="visually-hidden">
              <label for="Quantity" class="quantity-selector ">{{ 'products.product.quantity' | t }}</label>
              <input type="number" id="Quantity" name="quantity" value="1" min="1" class="quantity-selector">
            </div>

            <button type="submit" name="add" id="AddToCart" class="button">
              <span id="AddToCartText">{{ 'products.product.add_to_cart' | t }}</span>
            </button>
          </form>
        </div>

        <div class="wf-product-trust">
  <div class="wf-product-trust__item">
    <div class="wf-product-trust__icon">🎨</div>
    <div>
      <strong>Diseños inspirados en anime y cultura urbana.</strong>
      <p>Prendas creadas para quienes quieren vestir algo diferente.</p>
    </div>
  </div>

  <div class="wf-product-trust__item">
    <div class="wf-product-trust__icon">⭐</div>
    <div>
      <strong>Tela suave y cómoda.</strong>
      <p>Ideal para uso diario, con buen ajuste y acabado.</p>
    </div>
  </div>

  <div class="wf-product-trust__item">
    <div class="wf-product-trust__icon">🚚</div>
    <div>
      <strong>Entrega estimada de 2 a 5 días hábiles.</strong>
      <p>Realizamos envíos a todo México.</p>
    </div>
  </div>

  <div class="wf-product-trust__item">
    <div class="wf-product-trust__icon">🛡️</div>
    <div>
      <strong>Compra con confianza.</strong>
      <p>Cambios y devoluciones disponibles conforme a nuestras políticas.</p>
    </div>
  </div>
</div>

<style>
  .wf-product-trust {
    margin: 24px 0;
    border: 1px solid #dddddd;
    border-radius: 10px;
    overflow: hidden;
    background: #ffffff;
    color: #111111;
  }

  .wf-product-trust__item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 16px 18px;
    border-bottom: 1px solid #e8e8e8;
  }

  .wf-product-trust__item:last-child {
    border-bottom: 0;
  }

  .wf-product-trust__icon {
    font-size: 24px;
    line-height: 1.2;
    flex-shrink: 0;
  }

  .wf-product-trust__item strong {
    display: block;
    margin-bottom: 4px;
    font-weight: 700;
  }

  .wf-product-trust__item p {
    margin: 0;
    line-height: 1.45;
  }

  @media screen and (max-width: 749px) {
    .wf-product-trust__item {
      padding: 14px;
    }

    .wf-product-trust__icon {
      font-size: 22px;
    }
  }
</style>
<div class="wf-trust-icons">

  <div class="wf-trust-icons__item">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 2.5l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.3l-5.8 3.1 1.1-6.5-4.7-4.6 6.5-.9L12 2.5z"/>
    </svg>
    <strong>Calidad y comodidad</strong>
  </div>

  <div class="wf-trust-icons__item">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M3 6.5L12 2l9 4.5v11L12 22l-9-4.5v-11zM3 6.5l9 4.5 9-4.5M12 11v11"/>
    </svg>
    <strong>Envío rápido y seguro</strong>
  </div>

  <div class="wf-trust-icons__item">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M9 7H4V2M4.5 7.5A9 9 0 1 1 3 14"/>
      <path d="M4 2v5h5"/>
    </svg>
    <strong>Cambios y devoluciones</strong>
  </div>

</div>

<style>
  .wf-trust-icons {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin: 25px 0;
    padding: 22px 8px;
    border-top: 1px solid #e6e6e6;
    border-bottom: 1px solid #e6e6e6;
  }

  .wf-trust-icons__item {
    text-align: center;
    color: #111111;
  }

  .wf-trust-icons__item svg {
    width: 48px;
    height: 48px;
    display: block;
    margin: 0 auto 10px;
    fill: none;
    stroke: #111111;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .wf-trust-icons__item strong {
    display: block;
    font-size: 14px;
    line-height: 1.3;
    font-weight: 700;
  }

  @media screen and (max-width: 749px) {
    .wf-trust-icons {
      gap: 8px;
      padding: 18px 0;
    }

    .wf-trust-icons__item svg {
      width: 40px;
      height: 40px;
    }

    .wf-trust-icons__item strong {
      font-size: 12px;
    }
  }
</style>
<div class="wf-product-accordion">
  <details>
    <summary>
      <span>📦 Envíos</span>
      <span class="wf-product-accordion__plus">+</span>
    </summary>

    <div class="wf-product-accordion__content">
      <p><strong>Entrega estimada de 2 a 5 días hábiles.</strong></p>
      <p>Realizamos envíos a todo México.</p>
    </div>
  </details>
  <details>
  <summary>
    <span>↩️ Cambios y devoluciones</span>
    <span class="wf-product-accordion__plus">+</span>
  </summary>

  <div class="wf-product-accordion__content">
    <p><strong>Compra con tranquilidad.</strong></p>
    <p>Si necesitas solicitar un cambio o devolución, consulta nuestras políticas para conocer los requisitos, plazos y condiciones aplicables.</p>
  </div>
</details>
<details>
  <summary>
    <span>👕 Cuidados de la prenda</span>
    <span class="wf-product-accordion__plus">+</span>
  </summary>

  <div class="wf-product-accordion__content">
    <p><strong>Cuida tu prenda para conservarla por más tiempo.</strong></p>
    <p>• Lavar con agua fría y de preferencia al revés.</p>
    <p>• Usar detergente suave y evitar cloro.</p>
    <p>• No planchar directamente sobre el estampado.</p>
    <p>• Se recomienda secar al aire libre.</p>
  </div>
</details>
</div>


<style>
  .wf-product-accordion {
    margin: 18px 0;
    color: #111111;
  }

  .wf-product-accordion details {
    border-top: 1px solid #e5e5e5;
    border-bottom: 1px solid #e5e5e5;
  }

  .wf-product-accordion summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 4px;
    cursor: pointer;
    font-weight: 700;
    font-size: 16px;
    list-style: none;
  }

  .wf-product-accordion summary::-webkit-details-marker {
    display: none;
  }

  .wf-product-accordion__plus {
    font-size: 24px;
    font-weight: 400;
  }

  .wf-product-accordion details[open] .wf-product-accordion__plus {
    transform: rotate(45deg);
  }

  .wf-product-accordion__content {
    padding: 0 4px 18px;
    line-height: 1.6;
  }

  .wf-product-accordion__content p {
    margin: 0 0 10px;
  }
</style>
        <div class="product-description rte" itemprop="description">
          {{ product.description }}
        </div>

        {% if section.settings.show_share_buttons %}
          {% include 'social-sharing', share_title: product.title, share_permalink: product.url, share_image: product %}
        {% endif %}
      </div>
    </div>
  </div>
  {% comment %}
    Shopify Product App Reviews Markup
  {% endcomment %}
  {% if settings.add_spr_markup %}
  <div class="product__reviews row columns">
    <div id="shopify-product-reviews" data-id="{{product.id}}">{{ product.metafields.spr.reviews }}</div>
  </div>
  {% endif %}
</div>


{% schema %}
{
  "name": "Product Page",
  "settings": [
    {
      "type": "select",
      "id": "images_width",
      "label": "Images Width (Desktop)",
      "default": "50",
      "options": [
        {
          "value": "30",
          "label": "30%"
        },
        {
          "value": "50",
          "label": "50%"
        },
        {
          "value": "60",
          "label": "60%"
        },
        {
          "value": "70",
          "label": "70%"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "display_product_vendor",
      "label": "Display Product Vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_lightbox",
      "label": "Images Full Screen Mode",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_share_buttons",
      "label": "Show Share Buttons",
      "default": true
    }
  ]
}
{% endschema %}
