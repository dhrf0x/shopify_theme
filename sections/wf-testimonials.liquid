<section id="wf-testimonials-{{ section.id }}" class="wf-testimonials">
  <div class="wf-testimonials__inner">

    <div class="wf-testimonials__header">
      <div>
        {% if section.settings.heading != blank %}
          <h2 class="wf-testimonials__title">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <p class="wf-testimonials__subtitle">
            {{ section.settings.subheading }}
          </p>
        {% endif %}
      </div>

      {% if section.settings.show_arrows %}
        <div class="wf-testimonials__arrows">
          <button type="button"
            class="wf-testimonials__arrow"
            data-wf-prev
            aria-label="Anterior">
            ‹
          </button>

          <button type="button"
            class="wf-testimonials__arrow"
            data-wf-next
            aria-label="Siguiente">
            ›
          </button>
        </div>
      {% endif %}
    </div>

    <div class="wf-testimonials__track" data-wf-track>

      {% for block in section.blocks %}
        <article class="wf-testimonials__card" {{ block.shopify_attributes }}>

          {% if block.settings.image != blank %}
            <div class="wf-testimonials__image">
              {% assign image_alt = block.settings.image.alt | default: block.settings.customer %}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '320, 480, 640, 900',
                  sizes: '(max-width: 749px) 82vw, 360px',
                  alt: image_alt
              }}
            </div>
          {% endif %}

          <div class="wf-testimonials__stars"
               aria-label="{{ block.settings.rating }} de 5 estrellas">
            {% for i in (1..5) %}
              {% if i <= block.settings.rating %}
                ★
              {% else %}
                ☆
              {% endif %}
            {% endfor %}
          </div>

          {% if block.settings.review != blank %}
            <div class="wf-testimonials__review">
              “{{ block.settings.review | escape | newline_to_br }}”
            </div>
          {% endif %}

          {% if block.settings.customer != blank %}
            <div class="wf-testimonials__customer">
              — {{ block.settings.customer }}
            </div>
          {% endif %}

          {% if block.settings.product_name != blank %}
            <div class="wf-testimonials__product">
              {{ block.settings.product_name }}
            </div>
          {% endif %}

        </article>
      {% endfor %}

    </div>
  </div>
</section>


<style>
  #wf-testimonials-{{ section.id }} {
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    padding: 50px 0;
    overflow: hidden;
  }

  #wf-testimonials-{{ section.id }} .wf-testimonials__inner {
    width: min(1200px, calc(100% - 40px));
    margin: 0 auto;
  }

  #wf-testimonials-{{ section.id }} .wf-testimonials__header {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-bottom: 25px;
  }

  #wf-testimonials-{{ section.id }} .wf-testimonials__title {
    margin: 0;
    font-size: 30px;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  #wf-testimonials-{{ section.id }} .wf-testimonials__subtitle {
    margin: 8px 0 0;
    opacity: .75;
  }

  #wf-testimonials-{{ section.id }} .wf-testimonials__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(280px, 360px);
    gap: 18px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding: 4px 2px 15px;
    scrollbar-width: none;
  }

  #wf-testimonials-{{ section.id }} .wf-testimonials__track::-webkit-scrollbar {
    display: none;
  }

  #wf-testimonials-{{ section.id }} .wf-testimonials__card {
    background: {{ section.settings.card_color }};
    color: {{ section.settings.text_color }};
    border: 1px solid rgba(0,0,0,.10);
    border-radius: 14px;
    padding: 18px;
    scroll-snap-align: start;
  }

  #wf-testimonials-{{ section.id }} .wf-testimonials__image {
    margin: -18px -18px 18px;
    overflow: hidden;
    border-radius: 14px 14px 0 0;
  }

  #wf-testimonials-{{ section.id }} .wf-testimonials__image img {
    width: 100%;
    height: 260px;
    display: block;
    object-fit: cover;
  }

  #wf-testimonials-{{ section.id }} .wf-testimonials__stars {
    color: {{ section.settings.star_color }};
    font-size: 22px;
    letter-spacing: 2px;
    margin-bottom: 12px;
  }

  #wf-testimonials-{{ section.id }} .wf-testimonials__review {
    font-size: 17px;
    line-height: 1.5;
    font-weight: 600;
  }

  #wf-testimonials-{{ section.id }} .wf-testimonials__customer {
    margin-top: 16px;
    font-weight: 800;
  }

  #wf-testimonials-{{ section.id }} .wf-testimonials__product {
    margin-top: 4px;
    font-size: 13px;
    text-transform: uppercase;
    opacity: .65;
    letter-spacing: .06em;
  }

  #wf-testimonials-{{ section.id }} .wf-testimonials__arrows {
    display: flex;
    gap: 8px;
  }

  #wf-testimonials-{{ section.id }} .wf-testimonials__arrow {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid {{ section.settings.text_color }};
    background: transparent;
    color: {{ section.settings.text_color }};
    font-size: 28px;
    cursor: pointer;
    line-height: 1;
  }

  @media screen and (max-width: 749px) {
    #wf-testimonials-{{ section.id }} {
      padding: 35px 0;
    }

    #wf-testimonials-{{ section.id }} .wf-testimonials__inner {
      width: min(100% - 28px, 1200px);
    }

    #wf-testimonials-{{ section.id }} .wf-testimonials__title {
      font-size: 24px;
    }

    #wf-testimonials-{{ section.id }} .wf-testimonials__track {
      grid-auto-columns: 86%;
    }

    #wf-testimonials-{{ section.id }} .wf-testimonials__image img {
      height: 230px;
    }

    #wf-testimonials-{{ section.id }} .wf-testimonials__arrows {
      display: none;
    }
  }
</style>


<script>
  (function() {
    var root = document.getElementById('wf-testimonials-{{ section.id }}');
    if (!root) return;

    var track = root.querySelector('[data-wf-track]');
    var prev = root.querySelector('[data-wf-prev]');
    var next = root.querySelector('[data-wf-next]');

    if (!track) return;

    function move(direction) {
      var card = track.querySelector('.wf-testimonials__card');
      var amount = card
        ? card.getBoundingClientRect().width + 18
        : track.clientWidth * 0.85;

      track.scrollBy({
        left: amount * direction,
        behavior: 'smooth'
      });
    }

    if (prev) {
      prev.addEventListener('click', function() {
        move(-1);
      });
    }

    if (next) {
      next.addEventListener('click', function() {
        move(1);
      });
    }
  })();
</script>


{% schema %}
{
  "name": "Clientes WF",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "CLIENTES WF"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Lo que dicen quienes ya compraron."
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Mostrar flechas",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#f7f7f7"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Color de las tarjetas",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Color de las estrellas",
      "default": "#111111"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Reseña",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto (opcional)"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Calificación",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "review",
          "label": "Comentario",
          "default": "Excelente calidad y llegó súper rápido."
        },
        {
          "type": "text",
          "id": "customer",
          "label": "Nombre",
          "default": "Cliente WF"
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Producto (opcional)",
          "default": "WF Urban Muscle"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Clientes WF",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}